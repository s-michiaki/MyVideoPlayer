<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- WPF の Fluent テーマ (ThemeMode) は .NET 10 時点で試験的扱いのため警告を抑止 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <RootNamespace>MyVideoPlayer.App</RootNamespace>
    <AssemblyName>MyVideoPlayer</AssemblyName>
    <Product>MyVideoPlayer</Product>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Linux / CI 上でもビルドできるようにする -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!--
    発行時は exe 1つにまとめる（.NET ランタイム・DLL・json をすべて exe に内包）。
    VLC のプラグインは実行時にファイルとして必要なので libvlc\ フォルダだけは exe の隣に残る。
  -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.4" />
  </ItemGroup>

  <!-- libvlc は x64 版だけ同梱（x86 / ARM64 版を除外して配布サイズを抑える） -->
  <PropertyGroup>
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <!-- 再生に不要な VLC のファイル（開発用の .lib、ブラウザから操作する Web UI）は同梱しない -->
  <ItemGroup>
    <VlcWindowsX64ExcludeFiles Include="libvlc.lib;libvlccore.lib;lua\http\%2A%2A;lua\intf\%2A%2A" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyVideoPlayer.Core\MyVideoPlayer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- VLC 本体とプラグインは exe に入れず、libvlc\ フォルダにファイルとして置く（VLC がフォルダから読み込むため） -->
  <Target Name="KeepLibVlcOutsideSingleFile" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('/', '\').StartsWith('libvlc\'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
