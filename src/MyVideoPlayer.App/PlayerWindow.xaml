<Window x:Class="MyVideoPlayer.App.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MyVideoPlayer.App.ViewModels"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PlayerViewModel}"
        Title="MyVideoPlayer"
        Width="1280" Height="760" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        Foreground="{StaticResource TextBrush}"
        Icon="Assets/app.ico">

    <Window.Resources>
        <!-- チャプター／タイムスタンプ一覧の行（クリックでその位置へ） -->
        <Style x:Key="ClickableMarkerItem" TargetType="ListBoxItem" BasedOn="{StaticResource MarkerListItem}">
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnMarkerClick" />
        </Style>

        <DataTemplate x:Key="MarkerTemplate" DataType="{x:Type vm:MarkerItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="58" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StartText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                           FontFamily="Consolas, Segoe UI" VerticalAlignment="Top" Margin="0,1,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="2" Text="{Binding LengthText}" Foreground="{StaticResource SubtleTextBrush}"
                           FontSize="11.5" Margin="10,1,0,0" VerticalAlignment="Top" />
            </Grid>
        </DataTemplate>

        <Style x:Key="PlayPauseButton" TargetType="Button" BasedOn="{StaticResource BigIconButton}">
            <Setter Property="Content" Value="&#xE768;" />
            <Setter Property="ToolTip" Value="再生 (Space)" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Content" Value="&#xE769;" />
                    <Setter Property="ToolTip" Value="一時停止 (Space)" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnded}" Value="True">
                    <Setter Property="Content" Value="&#xE72C;" />
                    <Setter Property="ToolTip" Value="最初から再生" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MuteButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Content" Value="&#xE767;" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter Property="Content" Value="&#xE74F;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 上部: タイトル -->
        <Border x:Name="TopBar" Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="14,8"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" Command="{Binding PreviousVideoCommand}"
                            IsEnabled="{Binding HasPrevious}" ToolTip="前の動画 (P)" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding NextVideoCommand}"
                            IsEnabled="{Binding HasNext}" ToolTip="次の動画 (N)" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SubTitle}" FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding SubTitle, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 中央: 映像 + サイドパネル -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="SidePanelColumn" Width="340" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <vlc:VideoView x:Name="VideoView" Grid.Column="0" Background="Black">
                <!-- VideoView の中身は映像の上に重なる透明ウィンドウに表示される -->
                <Grid x:Name="Overlay" Background="#01000000"
                      MouseLeftButtonDown="OnOverlayMouseDown" MouseWheel="OnOverlayWheel" MouseMove="OnOverlayMouseMove">

                    <!-- 一瞬だけ出すメッセージ -->
                    <Border x:Name="OsdBorder" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18"
                            Background="#C0101216" CornerRadius="8" Padding="14,8" Opacity="0" IsHitTestVisible="False">
                        <TextBlock x:Name="OsdText" Foreground="White" FontSize="16" />
                    </Border>

                    <!-- 読み込み中 -->
                    <TextBlock Text="読み込み中…" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"
                               Foreground="#AAFFFFFF" IsHitTestVisible="False"
                               Visibility="{Binding IsBuffering, Converter={StaticResource BoolToVis}}" />

                    <!-- エラー -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#E0101216" CornerRadius="10"
                            Padding="22,16" Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ErrorText}" FontSize="15" Foreground="White" HorizontalAlignment="Center" />
                            <TextBlock Text="コーデックが対応していないか、ファイルが壊れている可能性があります。" Margin="0,6,0,0"
                                       Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 再生終了 -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#E0101216" CornerRadius="10"
                            Padding="22,16" Visibility="{Binding IsEnded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="再生が終わりました" FontSize="16" Foreground="White" HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Center">
                                <Button Content="もう一度再生" Command="{Binding TogglePlayCommand}" Padding="14,6" />
                                <Button Content="次の動画へ" Command="{Binding NextVideoCommand}" Margin="10,0,0,0" Padding="14,6"
                                        Style="{StaticResource AccentButton}"
                                        Visibility="{Binding HasNext, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </vlc:VideoView>

            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="4" ResizeBehavior="PreviousAndNext"
                          Background="{StaticResource BorderSubtleBrush}" Focusable="False" />

            <!-- サイドパネル: チャプター / 説明文のタイムスタンプ / 説明文 / 情報 -->
            <Border x:Name="SidePanel" Grid.Column="2" Background="{StaticResource PanelBrush}">
                <TabControl SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0" Padding="0"
                            Focusable="False">
                    <TabItem Focusable="False">
                        <TabItem.Header>
                            <TextBlock><Run Text="チャプター" /><Run Text=" " /><Run Text="{Binding Chapters.Count, Mode=OneWay}" Foreground="{StaticResource SubtleTextBrush}" /></TextBlock>
                        </TabItem.Header>
                        <Grid>
                            <ListBox x:Name="ChapterList" ItemsSource="{Binding Chapters}" ItemTemplate="{StaticResource MarkerTemplate}"
                                     ItemContainerStyle="{StaticResource ClickableMarkerItem}" Background="Transparent"
                                     BorderThickness="0" Padding="6" Focusable="False"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            <TextBlock Text="この動画にはチャプターが埋め込まれていません" Margin="16" TextWrapping="Wrap"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Visibility="{Binding Chapters.Count, Converter={StaticResource ZeroToVisible}}" />
                        </Grid>
                    </TabItem>
                    <TabItem Focusable="False">
                        <TabItem.Header>
                            <TextBlock ToolTip="説明文に書かれた「12:34 ○○」形式のタイムスタンプ"><Run Text="タイムスタンプ" /><Run Text=" " /><Run Text="{Binding Timestamps.Count, Mode=OneWay}" Foreground="{StaticResource SubtleTextBrush}" /></TextBlock>
                        </TabItem.Header>
                        <Grid>
                            <ListBox x:Name="TimestampList" ItemsSource="{Binding Timestamps}" ItemTemplate="{StaticResource MarkerTemplate}"
                                     ItemContainerStyle="{StaticResource ClickableMarkerItem}" Background="Transparent"
                                     BorderThickness="0" Padding="6" Focusable="False"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            <TextBlock Text="説明文にタイムスタンプが見つかりませんでした" Margin="16" TextWrapping="Wrap"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Visibility="{Binding Timestamps.Count, Converter={StaticResource ZeroToVisible}}" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="説明文" Focusable="False">
                        <Grid>
                            <TextBox Text="{Binding Description, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                                     Padding="12" Foreground="{StaticResource TextBrush}"
                                     Visibility="{Binding Description, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock Text="説明文（description / comment タグ）はありません" Margin="16" TextWrapping="Wrap"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Visibility="{Binding Description, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}"
                                       x:Name="NoDescriptionText" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="情報" Focusable="False">
                        <TextBox Text="{Binding InfoText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                                 Padding="12" Foreground="{StaticResource TextBrush}" />
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- 下部: シークバーと操作ボタン -->
        <Border x:Name="ControlsPanel" Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="12,4,12,8"
                MouseMove="OnControlsMouseMove">
            <StackPanel>
                <!-- チャプターの目盛り + シークバー -->
                <Grid>
                    <Canvas x:Name="MarkerCanvas" Height="8" Margin="10,0" VerticalAlignment="Top" ClipToBounds="False"
                            SizeChanged="OnMarkerCanvasSizeChanged" />
                    <Slider x:Name="SeekSlider" Margin="0,6,0,0" Minimum="0" Maximum="1" Focusable="False"
                            IsMoveToPointEnabled="True"
                            ValueChanged="OnSeekValueChanged"
                            Thumb.DragStarted="OnSeekDragStarted" Thumb.DragCompleted="OnSeekDragCompleted"
                            MouseMove="OnSeekMouseMove" MouseLeave="OnSeekMouseLeave" />
                    <Popup x:Name="SeekPreview" PlacementTarget="{Binding ElementName=SeekSlider}" Placement="Relative"
                           AllowsTransparency="True" IsHitTestVisible="False">
                        <Border Background="#F01C1F25" CornerRadius="6" Padding="10,5" BorderThickness="1"
                                BorderBrush="{StaticResource BorderSubtleBrush}">
                            <StackPanel>
                                <TextBlock x:Name="SeekPreviewTime" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock x:Name="SeekPreviewTitle" Foreground="{StaticResource SubtleTextBrush}" FontSize="11.5"
                                           MaxWidth="260" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <DockPanel Margin="0,2,0,0">
                    <!-- 右側 -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="RateCombo" ItemsSource="{Binding RateOptions}" SelectedItem="{Binding Rate}"
                                  ItemStringFormat="{}{0:0.##}x" MinWidth="80" ToolTip="再生速度 ([ / ])" Margin="0,0,6,0" />
                        <Button Style="{StaticResource MuteButton}" Command="{Binding ToggleMuteCommand}" ToolTip="ミュート (M)" />
                        <Slider Width="100" Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center"
                                Focusable="False" ToolTip="音量 (↑ / ↓)" IsMoveToPointEnabled="True"
                                IsSnapToTickEnabled="True" TickFrequency="1" />
                        <ToggleButton x:Name="SidePanelToggle" Style="{StaticResource IconToggle}" Content="&#xE8FD;" Margin="8,0,0,0"
                                      IsChecked="True" ToolTip="チャプター一覧の表示切り替え (C)"
                                      Checked="OnSidePanelToggled" Unchecked="OnSidePanelToggled" />
                        <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Content="&#xE740;"
                                Click="OnFullscreenClick" ToolTip="全画面 (F / ダブルクリック)" />
                    </StackPanel>

                    <!-- 左側 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE760;" Command="{Binding PreviousMarkerCommand}"
                                ToolTip="前のチャプター (PageUp)" />
                        <Button Style="{StaticResource PlayPauseButton}" Command="{Binding TogglePlayCommand}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE761;" Command="{Binding NextMarkerCommand}"
                                ToolTip="次のチャプター (PageDown)" />
                        <Button Style="{StaticResource IconButton}" Content="&#xEB9E;" Command="{Binding SkipBackCommand}"
                                ToolTip="10 秒戻る (J)" Margin="6,0,0,0" />
                        <Button Style="{StaticResource IconButton}" Content="&#xEB9D;" Command="{Binding SkipForwardCommand}"
                                ToolTip="10 秒進む (L)" />
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontFamily="Consolas, Segoe UI">
                            <Run x:Name="PositionRun" Text="{Binding PositionText, Mode=OneWay}" /><Run Text=" / " Foreground="{StaticResource SubtleTextBrush}" /><Run Text="{Binding DurationText, Mode=OneWay}" Foreground="{StaticResource SubtleTextBrush}" />
                        </TextBlock>
                        <TextBlock Text="{Binding CurrentMarkerTitle}" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
