<Window x:Class="MyVideoPlayer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MyVideoPlayer.App.ViewModels"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
        Title="MyVideoPlayer"
        Width="1280" Height="800" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        Foreground="{StaticResource TextBrush}"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        Icon="Assets/app.ico">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding BrowseFolderCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ツールバー -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="12,10"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding BrowseFolderCommand}" ToolTip="フォルダを開く (Ctrl+O)" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Text="フォルダを開く" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RecentButton" Margin="6,0,0,0" Padding="8,6" ToolTip="最近開いたフォルダ"
                            Click="OnRecentClick">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                        <Button.ContextMenu>
                            <!-- 項目はクリック時にコードで作る -->
                            <ContextMenu x:Name="RecentMenu" />
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding FolderPath}" Margin="14,0" VerticalAlignment="Center"
                           Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding FolderPath}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="220">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 ToolTip="ファイル名・フォルダ名で絞り込み (Ctrl+F)" Padding="30,5,8,5" VerticalContentAlignment="Center" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Margin="10,0,0,0" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                    </Grid>
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                              DisplayMemberPath="Label" Margin="8,0,0,0" MinWidth="150" ToolTip="並べ替え" />
                    <CheckBox Content="サブフォルダも" IsChecked="{Binding IncludeSubfolders}" Margin="12,0,0,0"
                              VerticalAlignment="Center" ToolTip="サブフォルダ内の動画も一覧に含める" />
                    <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" Margin="10,0,4,0" VerticalAlignment="Center"
                               Foreground="{StaticResource SubtleTextBrush}" ToolTip="サムネイルの大きさ" />
                    <Slider Width="90" Minimum="160" Maximum="420" Value="{Binding ThumbnailWidth}" VerticalAlignment="Center"
                            ToolTip="サムネイルの大きさ" PreviewMouseUp="OnThumbSizeChanged" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}"
                            ToolTip="再読み込み (F5)" Margin="6,0,0,0" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="その他" Click="OnMoreClick">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="ffmpeg のフォルダを指定…" Command="{Binding ChooseFfmpegFolderCommand}" />
                                <MenuItem Header="サムネイルのキャッシュを削除…" Command="{Binding ClearCacheCommand}" />
                                <Separator />
                                <MenuItem Header="データフォルダを開く" Click="OnOpenDataFolder" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ffmpeg が見つからないときの案内 -->
        <Border Grid.Row="1" Background="#3A2A1C" Padding="14,8"
                Visibility="{Binding FfmpegMissing, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="入手方法" Command="{Binding OpenFfmpegHelpCommand}" Margin="0,0,8,0" Padding="10,4" />
                    <Button Content="フォルダを指定…" Command="{Binding ChooseFfmpegFolderCommand}" Padding="10,4" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentBrush}" />
                    <Run Text=" ffmpeg / ffprobe が見つかりません。再生はできますが、サムネイルと説明文のタイムスタンプの取得には ffmpeg が必要です。" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- フォルダ未選択のとき -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasFolder, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="64" HorizontalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="動画を保存しているフォルダを選んでください" FontSize="18" Margin="0,18,0,6" HorizontalAlignment="Center" />
            <TextBlock Text="ここにフォルダをドラッグ＆ドロップしても開けます" Foreground="{StaticResource SubtleTextBrush}"
                       HorizontalAlignment="Center" />
            <Button Content="フォルダを選択…" Command="{Binding BrowseFolderCommand}" Margin="0,20,0,0" Padding="18,8"
                    HorizontalAlignment="Center" Style="{StaticResource AccentButton}" />
        </StackPanel>

        <!-- 動画一覧 -->
        <ListBox x:Name="VideoList" Grid.Row="2"
                 ItemsSource="{Binding View}"
                 SelectedItem="{Binding SelectedItem}"
                 Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}"
                 Background="Transparent" BorderThickness="0" Padding="10,8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 MouseDoubleClick="OnListDoubleClick"
                 KeyDown="OnListKeyDown">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <vwp:VirtualizingWrapPanel SpacingMode="StartAndEndOnly" StretchItems="False" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="再生" Command="{Binding PlayCommand}" CommandParameter="{Binding SelectedItem}" InputGestureText="Enter" />
                    <MenuItem Header="エクスプローラーで表示" Command="{Binding ShowInExplorerCommand}" CommandParameter="{Binding SelectedItem}" />
                    <MenuItem Header="パスをコピー" Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedItem}" />
                </ContextMenu>
            </ListBox.ContextMenu>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="6" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="{StaticResource CardBrush}" CornerRadius="10"
                                        BorderThickness="2" BorderBrush="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:VideoItemViewModel}">
                    <StackPanel Width="{Binding DataContext.ThumbnailWidth, RelativeSource={RelativeSource AncestorType=ListBox}}">
                        <!-- サムネイル（16:9） -->
                        <Border CornerRadius="8,8,0,0" ClipToBounds="True" Background="#0E0F12"
                                Height="{Binding DataContext.ThumbnailWidth, RelativeSource={RelativeSource AncestorType=ListBox},
                                         Converter={StaticResource Multiply}, ConverterParameter=0.5625}">
                            <Grid>
                                <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#3A3F4A" />
                                <Image Source="{Binding ThumbnailPath, Converter={StaticResource ThumbPath}}"
                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />

                                <!-- 左上: チャプター数・タイムスタンプ数 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Border Style="{StaticResource Badge}" Margin="6,6,0,0" ToolTip="チャプター"
                                            Visibility="{Binding ChapterCount, Converter={StaticResource NullToCollapsed}}">
                                        <TextBlock Style="{StaticResource BadgeText}">
                                            <Run Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" /><Run Text=" " /><Run Text="{Binding ChapterCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <Border Style="{StaticResource Badge}" Margin="6,6,0,0" ToolTip="説明文のタイムスタンプ"
                                            Visibility="{Binding TimestampCount, Converter={StaticResource NullToCollapsed}}">
                                        <TextBlock Style="{StaticResource BadgeText}">
                                            <Run Text="&#xE916;" FontFamily="{StaticResource IconFont}" /><Run Text=" " /><Run Text="{Binding TimestampCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </StackPanel>

                                <!-- 右上: 解像度 -->
                                <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding ResolutionText, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding ResolutionText}" />
                                </Border>

                                <!-- 右下: 長さ -->
                                <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Visibility="{Binding DurationText, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding DurationText}" />
                                </Border>

                                <!-- 下端: 途中まで見た位置 -->
                                <ProgressBar VerticalAlignment="Bottom" Height="3" MinHeight="3" Minimum="0" Maximum="1"
                                             Value="{Binding ResumeRatio, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"
                                             Background="#55000000" BorderThickness="0"
                                             Visibility="{Binding ResumeRatio, Converter={StaticResource NullToCollapsed}}" />
                            </Grid>
                        </Border>

                        <!-- ファイル名など -->
                        <StackPanel Margin="10,8,10,10">
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       MaxHeight="40" FontSize="13" LineHeight="20" />
                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource SubtleTextBrush}" FontSize="11.5"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Extension, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SizeText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding DateText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Folder}" Margin="0,2,0,0" Foreground="{StaticResource SubtleTextBrush}"
                                       FontSize="11.5" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ステータスバー -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" Padding="14,5"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                           Text="ダブルクリック / Enter で再生" />
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="60" Height="4" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
